{
  "name": "@deeply-bubbly/web",
  "version": "0.1.0",
  "private": true,
  "description": "Browser shell: Phaser 3 presentation + input for Deeply Bubbly.",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src e2e",
    "test": "echo 'no unit tests in web shell (logic lives in @deeply-bubbly/core)'",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@deeply-bubbly/core": "workspace:*",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "vite": "^8.0.0"
  }
}
