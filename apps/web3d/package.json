{
  "name": "@deeply-bubbly/web3d",
  "version": "0.1.0",
  "private": true,
  "description": "Browser shell: Three.js presentation + input for Deeply Bubbly (low-poly 3D, played on a plane).",
  "type": "module",
  "scripts": {
    "dev": "vite --host --port 5174",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview --host --port 4174",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src e2e",
    "test": "echo 'no unit tests in web3d shell (logic lives in @deeply-bubbly/core)'",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@deeply-bubbly/core": "workspace:*",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/three": "0.186.0",
    "vite": "^8.0.0"
  }
}
